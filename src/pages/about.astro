---
import aboutCompanyImg from "../assets/about_company.jpeg";
import aboutFounderImg from "../assets/about_founder.jpeg";

import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Navbar isAbout={true} />

  <div class="container mx-auto p-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Text -->
      <div>
        <h1 class="text-4xl font-bold text-gray-800">About The Company</h1>
        <p class="text-sm text-gray-600 leading-relaxed mt-4 text-justify">
          <strong>Gold Sterling Technologies</strong> is a leading manufacturer dedicated
          to delivering innovative and cutting-edge products for clean and renewable
          energy solutions.
        </p>
        <p class="text-sm text-gray-600 leading-relaxed mt-4 text-justify">
          Since our inception in 2019, Gold Sterling Technologies has built a
          strong reputation for innovation, quality, reliability, user-centric
          design, and exceptional service support. With decades of combined
          experience in development, manufacturing, and customer service, our
          products are engineered to perform under diverse environmental and
          power conditions, catering to various user needs.
        </p>
        <p class="text-sm text-gray-600 leading-relaxed mt-4 text-justify">
          From pioneering lead-acid battery-based power backup solutions to
          developing advanced renewable energy devices, Gold Sterling
          Technologies is committed to promoting sustainable energy while
          expanding our product offerings. We also provide design and
          consultancy services to ensure robust product implementation, meeting
          the unique demands of our partners and clients.
        </p>
        <p class="text-sm text-gray-600 leading-relaxed mt-4 text-justify">
          We continue to grow our network by collaborating with channel
          partners, design consultancies, and OEM partners, reinforcing our
          dedication to customer-centricity and long-term business
          relationships. At Gold Sterling Technologies, we aim to deliver
          high-quality end products and create positive experiences for our
          clients.
        </p>
      </div>

      <!-- Image -->
      <div class="self-center">
        <img
          src={aboutCompanyImg.src}
          alt="About Us Image"
          class="w-full h-auto max-w-lg mx-auto border-red-500 border-t-4 rounded-lg shadow-lg"
        />
      </div>

      <!-- Text -->
      <div>
        <h1 class="text-4xl font-bold text-gray-800">About the Founder</h1>
        <p class="text-sm text-gray-600 leading-relaxed mt-4 text-justify">
          <strong>Mrs. Nibedita Mukherjee</strong> is a focused and visionary entrepreneur
          with industry experience since 2016. She excels in customer interactions,
          delivering innovative solutions, and providing exceptional support. Her
          expertise in successfully managing multiple business deals highlights her
          commitment to client satisfaction and her ability to drive impactful results.
        </p>
        <p class="text-sm text-gray-600 leading-relaxed mt-4 text-justify">
          Mrs. Mukherjee's leadership is a cornerstone of our success, steering
          the company toward continuous growth and innovation in the renewable
          energy sector.
        </p>
      </div>

      <!-- Image -->
      <div class="self-center">
        <img
          src={aboutCompanyImg.src}
          alt="About the Founder Image"
          class="w-full h-auto max-w-lg mx-auto border-red-500 border-t-4 rounded-lg shadow-lg"
        />
      </div>
    </div>
  </div>
</Layout>
