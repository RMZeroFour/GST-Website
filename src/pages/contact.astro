---
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Navbar isContact={true} />

  <div class="container mx-auto p-8">
    <h1 class="text-4xl font-bold text-gray-800 mb-4 text-left">Contact Us</h1>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Contact Form -->
      <div>
        <p class="text-sm text-gray-600 mb-6 text-left">
          Please fill out the form below or reach out to us at
          <a
            href="mailto:nibedita@gold-sterling.com"
            class="underline text-red-500 hover:text-red-600"
          >
            nibedita@gold-sterling.com
          </a>
          .
        </p>

        <form
          action="https://formspree.io/f/{your_form_id}"
          method="POST"
          class="space-y-6"
        >
          <div>
            <label for="name" class="text-sm text-gray-700 block mb-2"
              >Your Name</label
            >
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full p-3 border border-gray-300 rounded-lg"
            />
          </div>

          <div>
            <label for="email" class="text-sm text-gray-700 block mb-2"
              >Your Email</label
            >
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full p-3 border border-gray-300 rounded-lg"
            />
          </div>

          <div>
            <label for="message" class="text-sm text-gray-700 block mb-2"
              >Your Message</label
            >
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="w-full p-3 border border-gray-300 rounded-lg"></textarea>
          </div>

          <button
            type="submit"
            class="bg-red-500 text-white py-3 px-6 rounded-lg hover:bg-red-600"
            >Submit</button
          >
        </form>
      </div>

      <!-- Embedded Map -->
      <div>
        <iframe
          allowfullscreen={true}
          class="rounded-lg w-full h-full border-red-500 border-t-4"
          src="https://maps.google.com/maps?width=100%25&height=600&hl=en&q=28.542670,%2077.034740+(Gold%20Sterling%20Technologies)&t=k&z=19&ie=UTF8&iwloc=B&output=embed"
        ></iframe>
      </div>
    </section>
  </div>
</Layout>
